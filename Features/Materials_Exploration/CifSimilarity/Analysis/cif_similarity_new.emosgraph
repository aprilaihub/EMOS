    {
      "id": "node_8",
      "type": "utility",
      "key": "lambda",
      "name": "Lambda",
      "x": 403.24118317219353,
      "y": 585.4643063913585,
      "width": 310.7245086308447,
      "height": 321.2039309532422,
      "breakpointEnabled": false,
      "configuration": {
        "fields": [
          {
            "name": "code",
            "value": "# Calculate AMD\n\noutput_cifs = cif_list\n\nk = 15\nitems = results.get(\"results\", [])\nassert items, \"No PDD results received.\"\n\nvectors = []\nlabels = []\n\nfor i, item in enumerate(items):\n    assert item.get(\"status\") == \"ok\", \"A PDD computation failed.\"\n\n    pdd = item.get(\"properties\", {}).get(\"pdd_matrix\")\n    assert pdd, \"Missing PDD matrix.\"\n    assert all(len(row) >= k + 1 for row in pdd), \\\n        \"PDD needs at least 15 neighbours.\"\n    assert all(\n        all(0 <= value < float(\"inf\") for value in row[:k + 1])\n        for row in pdd\n    ), \"Invalid weight or distance.\"\n\n    weight = sum(row[0] for row in pdd)\n    assert 0 < weight < float(\"inf\"), \"Invalid total weight.\"\n\n    # Column 0 contains weights; columns 1–15 contain distances.\n    vector = [\n        sum((row[0] / weight) * row[j] for row in pdd)\n        for j in range(1, k + 1)\n    ]\n    vectors.append(vector)\n\n    label = (\n        item.get(\"label\")\n        or item.get(\"material_name\")\n        or item.get(\"formula\")\n        or \"CIF \" + str(i + 1)\n    )\n    labels.append(str(label))\n\nn = len(vectors)\nmatrix = [[0.0 for j in range(n)] for i in range(n)]\n\nfor i in range(n):\n    for j in range(i + 1, n):\n        distance = sum(\n            (vectors[i][d] - vectors[j][d]) ** 2\n            for d in range(k)\n        ) ** 0.5\n        assert distance < float(\"inf\"), \\\n            \"Distance overflow; check input scales.\"\n\n        matrix[i][j] = distance\n        matrix[j][i] = distance\n\noutput_results = {\"matrix\": matrix, \"labels\": labels}"
          }
        ]
      }
    },
