    {
      "id": "node_10",
      "type": "utility",
      "key": "lambda",
      "name": "Lambda",
      "x": 1776.9199885907153,
      "y": 274.27393363764776,
      "width": 320,
      "height": null,
      "breakpointEnabled": false,
      "configuration": {
        "fields": [
          {
            "name": "code",
            "value": "#deduplicate by composition\n\nrows = results.get(\"results\", [])\nassert len(cif_list) == len(rows), \"Connect matching CIFs and GBFS results.\"\n\nseen = {}\noutput_cifs = []\nkept = []\n\nfor cif, row in zip(cif_list, rows):\n    name = row.get(\"material_name\") or row.get(\"formula\") or row.get(\"composition\")\n\n    if not name:\n        block_name = \"\"\n        for line in cif.split(\"\\n\"):\n            parts = line.strip().split(None, 1)\n            if not parts:\n                continue\n            tag = parts[0].lower()\n            if tag.startswith(\"data_\"):\n                block_name = parts[0][5:]\n            if tag in (\"_chemical_formula_sum\", \"_chemical_formula_structural\") and len(parts) == 2:\n                name = \"\".join(parts[1].strip(\"\\\"'\").split())\n                if name not in (\"\", \".\", \"?\"):\n                    break\n                name = \"\"\n        if not name and not block_name.lower().startswith(\"generated\"):\n            name = block_name.replace(\"_\", \" \").replace(\"-\", \" \")\n\n    if name and name in seen:\n        continue\n    if name:\n        seen[name] = True\n\n    entry = row.copy()\n    entry[\"index\"] = len(output_cifs)\n    output_cifs.append(cif)\n    kept.append(entry)\n\noutput_results = results.copy()\noutput_results[\"results\"] = kept"
          }
        ]
      }
    },
    {
      "id": "node_12",
      "type": "predictor",
      "key": "mattersim",
      "name": "MatterSim",
      "x": 2182.8370206468653,
      "y": 204.85936600372006,
      "width": 320,
      "height": null,
      "breakpointEnabled": false,
      "configuration": {
        "fields": []
      }
    },
    {
      "id": "node_15",
      "type": "utility",
      "key": "lambda",
      "name": "Lambda",
      "x": 2179.6536896572384,
      "y": 414.1355716833983,
      "width": 320,
      "height": null,
      "breakpointEnabled": false,
      "configuration": {
        "fields": [
          {
            "name": "code",
            "value": "#Force-based stability filtering\n\nthreshold = 0.10\nforce_key = \"relaxed_forces\"\n\nrows = results.get(\"results\", [])\nassert not cif_list or len(cif_list) == len(rows), \"CIFs and results must match.\"\noutput_cifs = []\nkept = []\n\nfor i, row in enumerate(rows):\n    if row.get(\"status\") == \"error\" or row.get(\"error\"):\n        continue\n\n    forces = (row.get(\"properties\") or {}).get(force_key)\n    if not forces or not all(len(vector) == 3 for vector in forces):\n        continue\n\n    magnitudes = [\n        sum(component * component for component in vector) ** 0.5\n        for vector in forces\n    ]\n    if not all(magnitude <= threshold for magnitude in magnitudes):\n        continue\n\n    cif = cif_list[i] if cif_list else row.get(\"cif_input\")\n    assert cif, \"A retained result has no matching CIF.\"\n\n    entry = row.copy()\n    entry[\"index\"] = len(kept)\n    output_cifs.append(cif)\n    kept.append(entry)\n\noutput_results = results.copy()\noutput_results[\"results\"] = kept"
          }
        ]
      }
    },
