{
  "version": "3.0.0",
  "description": "Display-name-based minimal EMOS metadata - all names derived from display names",
  "naming_conventions": {
    "source_of_truth": "Display names are the primary source - everything else is derived",
    "derivation_order": "Display Name → Folder Name → Class Name → File Name → ID",
    "folder_names": "PascalCase derived from display names",
    "python_files": "{ClassName}.py where ClassName = {FolderName}{Type}",
    "javascript_files": "{FolderName}.js (features only)", 
    "class_names": "{FolderName}{Type} where Type = Feature|Database|Generator|Predictor",
    "ids": "snake_case derived from display names with special case handling"
  },
  "derivation_rules": {
    "display_to_folder": "Remove special chars, PascalCase words (with special case overrides)",
    "display_to_id": "Convert to snake_case, handle special abbreviations", 
    "display_to_class": "FolderName + Type suffix",
    "display_to_file": "ClassName + .py/.js extension",
    "display_to_path": "Features/{Category}/{FolderName}/ or Information_Units/{Type}/{FolderName}/"
  },
  "information_units": {
      "databases": {
        "COD": "Crystallography Open Database - open-access collection of crystal structures", 
        "MaterialsProject": "Materials Project - computational materials database",
        "Alexandria": "Alexandria PBE - DFT database for materials properties",
        "Mathub3d": "MatHub-3d - first-principles materials repository with 3D structures for high-throughput thermoelectric research",
        "JarvisDFT": "JARVIS-DFT - NIST computational materials database with electronic, optical, and solar cell properties",
        "AFLOW": "AFLOW - Automatic FLOW database for computational materials science with rich mechanical, thermal, and electronic properties"
      },
    "generators": {
      "MatterGen: Base Model": "Unconditional diffusion model for general inorganic crystal structure generation (mattergen_base)",
      "MatterGen: MP-20 Base": "Unconditional base model trained on the MP-20 dataset for crystal structure generation (mp_20_base)",
      "MatterGen: Chemical System": "Conditional model for generating structures within a specified chemical system (chemical_system)",
      "MatterGen: Chemical System + Stability": "Conditional model for generating structures within a chemical system with target energy above hull (chemical_system_energy_above_hull)",
      "MatterGen: DFT Band Gap": "Property-conditioned model for generating structures with a target DFT band gap (dft_band_gap)",
      "MatterGen: Magnetic Density": "Property-conditioned model for generating structures with a target DFT magnetic density (dft_mag_density)",
      "MatterGen: Magnetic Density + HHI": "Multi-property-conditioned model targeting magnetic density and Herfindahl-Hirschman elemental scarcity index (dft_mag_density_hhi_score)",
      "MatterGen: Bulk Modulus": "Property-conditioned model for generating structures with a target ML-predicted bulk modulus (ml_bulk_modulus)",
      "MatterGen: Space Group": "Symmetry-conditioned model for generating structures in a target crystallographic space group (space_group)",
      "GNoME": "Graph Networks for Materials Exploration", 
      "iMatGen": "Inverse materials generation using deep learning",
      "MatGAN": "Generative Adversarial Network for materials design",
      "MolGAN": "Molecular Generative Adversarial Network",
      "Cond-DFC-VAE": "Conditional Deep Feature Consistent Variational Autoencoder",
      "MyGen1": "Custom generator 1 - user-defined materials generation model",
      "MyGen2": "Custom generator 2 - user-defined materials generation model"
    },
    "predictors": {
      "MatterSim": "Universal neural network potential for materials simulation",
      "M3GNet": "Materials 3D Graph Network for property prediction",
      "PFP": "Property Fingerprint Predictor for materials properties",
      "DeepMD": "Deep potential molecular dynamics for materials simulation",
      "SynthNN": "Synthesis Neural Network for synthesizability prediction", 
      "eSEN": "Electronic Structure Estimation Network",
      "MyPred1": "Custom predictor 1 - user-defined materials property prediction model",
      "MyPred2": "Custom predictor 2 - user-defined materials property prediction model"
    }
  },
  "features": {
    "materials_exploration": {
      "Material Search": "Search and explore materials from comprehensive databases using various criteria",
      "Material Generation": "Generate new material compositions using AI-powered algorithms and predictive models",
      "Database Extractor": "Extract and analyze specific material properties and data from integrated databases", 
      "Material Characterization": "Advanced materials analysis and characterization tools for comprehensive evaluation",
      "DFT Calculation": "Materials optimization workflows for enhanced performance characteristics",
      "Crystallographic Analysis": "Simulation and modeling tools for predicting material behavior under various conditions",
      "Quantum Mechanics": "Advanced computational methods for materials discovery and design",
      "Tensor Analysis": "Comprehensive analysis tools for understanding material structure-property relationships"
    },
    "electronics_application": {
      "Device Synthesizability": "Evaluate the feasibility and methods for synthesizing electronic devices from selected materials",
      "Interface Calculation": "Calculate and analyze interfaces between different materials in electronic applications",
      "Property Prediction": "Electronic property prediction and optimization for semiconductor applications",
      "Band Structure": "Band structure calculations and electronic transport property analysis", 
      "Thermal Management": "Thermal management analysis for electronic device performance optimization",
      "Reliability Assessment": "Reliability assessment and failure analysis for electronic materials",
      "Process Integration": "Process integration workflows for electronic device manufacturing",
      "Advanced Characterization": "Advanced characterization techniques for electronic materials evaluation"
    }
  },
  "feature_inputs_outputs": {
    "Material Search": {
      "inputs": [
        {"name": "materialName", "display_name": "Material Name/Formula", "type": "text", "required": false, "default": "", "placeholder": "e.g., Al2O3, Silicon, etc.", "description": "Material name or chemical formula for search"},
        {"name": "propertyType", "display_name": "Property Type", "type": "select", "required": false, "options": [{"value": "", "text": "Select Property"}, {"value": "mechanical", "text": "Mechanical Properties"}, {"value": "thermal", "text": "Thermal Properties"}, {"value": "electrical", "text": "Electrical Properties"}, {"value": "optical", "text": "Optical Properties"}], "default": "", "description": "Type of material property to search by"},
        {"name": "minValue", "display_name": "Minimum Value", "type": "number", "required": false, "min": 0, "max": 10000, "step": 0.1, "default": 0, "description": "Minimum property value for filtering"},
        {"name": "maxValue", "display_name": "Maximum Value", "type": "number", "required": false, "min": 0, "max": 10000, "step": 0.1, "default": 0, "description": "Maximum property value for filtering"},
        {"name": "includeComposites", "display_name": "Include Composite Materials", "type": "checkbox", "required": false, "default": true, "description": "Include composite materials in search results"}
      ],
      "outputs": [
        {"name": "materialsCount", "display_name": "Materials Found", "type": "text", "description": "Number of materials found matching search criteria"},
        {"name": "topMatch", "display_name": "Top Match", "type": "text", "description": "Best matching material from search results"}, 
        {"name": "propertyRange", "display_name": "Property Range", "type": "text", "description": "Range of property values in search results"},
        {"name": "downloadLink", "display_name": "Download", "type": "link", "description": "Download link for complete search results"}
      ]
    },
    "Material Generation": {
      "inputs": [
        {"name": "targetProperty", "display_name": "Target Property", "type": "select", "required": true, "options": [{"value": "high_strength", "text": "High Mechanical Strength"}, {"value": "thermal_conductivity", "text": "High Thermal Conductivity"}, {"value": "electrical_insulator", "text": "Electrical Insulator"}, {"value": "semiconductor", "text": "Semiconductor"}, {"value": "superconductor", "text": "Superconductor"}], "default": "high_strength", "description": "Target property for material generation"},
        {"name": "baseElements", "display_name": "Base Element Group", "type": "select", "required": true, "options": [{"value": "metals", "text": "Metals (Fe, Al, Ti, etc.)"}, {"value": "ceramics", "text": "Ceramics (Si, O, N, etc.)"}, {"value": "polymers", "text": "Polymers (C, H, O, etc.)"}, {"value": "composites", "text": "Composite Materials"}], "default": "metals", "description": "Base element group for generation"},
        {"name": "numCompositions", "display_name": "Number of Compositions", "type": "number", "required": true, "min": 1, "max": 100, "step": 1, "default": 10, "description": "Number of material compositions to generate"},
        {"name": "targetValue", "display_name": "Target Property Value", "type": "number", "required": false, "min": 0, "max": 1000, "step": 0.1, "default": 0, "description": "Target property value"},
        {"name": "includeRareElements", "display_name": "Include Rare Earth Elements", "type": "checkbox", "required": false, "default": false, "description": "Include rare earth elements in generation"},
        {"name": "optimizeForCost", "display_name": "Optimize for Cost-Effectiveness", "type": "checkbox", "required": false, "default": true, "description": "Optimize for cost-effectiveness"}
      ],
      "outputs": [
        {"name": "generatedCount", "display_name": "Generated Compositions", "type": "text", "description": "Number of compositions generated"},
        {"name": "bestCandidate", "display_name": "Best Candidate", "type": "text", "description": "Best material candidate"},
        {"name": "predictedPerformance", "display_name": "Predicted Performance", "type": "text", "description": "Performance prediction"},
        {"name": "synthesisDifficulty", "display_name": "Synthesis Difficulty", "type": "text", "description": "Difficulty level for synthesis"},
        {"name": "exportData", "display_name": "Export Data", "type": "link", "description": "Export generated compositions"}
      ]
    },
    "Database Extractor": {
      "inputs": [
        {"name": "databaseSource", "display_name": "Database Source", "type": "select", "required": true, "options": [{"value": "all", "text": "All Databases"}, {"value": "materialsproject", "text": "Materials Project"}, {"value": "oqmd", "text": "OQMD"}, {"value": "aflow", "text": "AFLOW"}, {"value": "crystallography", "text": "Crystallography DB"}], "default": "all", "description": "Database source for extraction"},
        {"name": "extractionType", "display_name": "Extraction Type", "type": "select", "required": true, "options": [{"value": "properties", "text": "Material Properties"}, {"value": "structures", "text": "Crystal Structures"}, {"value": "thermodynamics", "text": "Thermodynamic Data"}, {"value": "experimental", "text": "Experimental Data"}], "default": "properties", "description": "Type of data to extract"},
        {"name": "filterCriteria", "display_name": "Filter Criteria", "type": "text", "required": false, "placeholder": "e.g., space_group=225, bandgap>1.0", "description": "Filter criteria for extraction"},
        {"name": "maxEntries", "display_name": "Maximum Entries", "type": "number", "required": false, "min": 1, "max": 10000, "step": 1, "default": 1000, "description": "Maximum number of entries to extract"},
        {"name": "configFile", "display_name": "Configuration File", "type": "file", "required": false, "accept": ".json,.yaml", "description": "Optional configuration file"},
        {"name": "includeMetadata", "display_name": "Include Metadata", "type": "checkbox", "required": false, "default": true, "description": "Include metadata in extraction"}
      ],
      "outputs": [
        {"name": "recordsExtracted", "display_name": "Records Extracted", "type": "text", "description": "Number of records extracted"},
        {"name": "dataSize", "display_name": "Data Size", "type": "text", "description": "Total size of extracted data"},
        {"name": "fileFormat", "display_name": "File Format", "type": "text", "description": "Format of extracted data"},
        {"name": "processingTime", "display_name": "Processing Time", "type": "text", "description": "Time taken for extraction"},
        {"name": "downloadPackage", "display_name": "Download Package", "type": "link", "description": "Download extracted data package"}
      ]
    },
    "Material Characterization": {
      "inputs": [
        {"name": "materialFormula", "display_name": "Material Formula", "type": "text", "required": true, "placeholder": "e.g., Al2O3, SiC", "description": "Material formula for characterization"},
        {"name": "analysisType", "display_name": "Analysis Type", "type": "select", "required": true, "options": [{"value": "basic", "text": "Basic Analysis"}, {"value": "advanced", "text": "Advanced Analysis"}, {"value": "comprehensive", "text": "Comprehensive Analysis"}], "default": "basic", "description": "Type of analysis to perform"},
        {"name": "threshold", "display_name": "Threshold Value", "type": "number", "required": false, "min": 0, "max": 100, "step": 0.1, "default": 50, "description": "Threshold value for analysis"},
        {"name": "exportResults", "display_name": "Export Results", "type": "checkbox", "required": false, "default": true, "description": "Export analysis results"}
      ],
      "outputs": [
        {"name": "analysisStatus", "display_name": "Analysis Status", "type": "text", "description": "Status of the analysis"},
        {"name": "materialProperties", "display_name": "Material Properties", "type": "text", "description": "Calculated material properties"},
        {"name": "reportGeneration", "display_name": "Report Generation", "type": "text", "description": "Report generation status"}
      ]
    },
    "DFT Calculation": {
      "inputs": [
        {"name": "optimizationTarget", "display_name": "Optimization Target", "type": "select", "required": true, "options": [{"value": "performance", "text": "Performance"}, {"value": "cost", "text": "Cost"}, {"value": "efficiency", "text": "Efficiency"}], "default": "performance", "description": "Optimization target for DFT calculation"},
        {"name": "iterations", "display_name": "Iterations", "type": "number", "required": false, "min": 10, "max": 1000, "step": 10, "default": 100, "description": "Number of optimization iterations"},
        {"name": "configFile", "display_name": "Configuration File", "type": "file", "required": false, "accept": ".json,.xml", "description": "Configuration file for DFT"},
        {"name": "verboseOutput", "display_name": "Verbose Output", "type": "checkbox", "required": false, "default": false, "description": "Enable verbose output"}
      ],
      "outputs": [
        {"name": "convergenceStatus", "display_name": "Convergence Status", "type": "text", "description": "Convergence status of optimization"},
        {"name": "performanceImprovement", "display_name": "Performance Improvement", "type": "text", "description": "Performance improvement achieved"},
        {"name": "configurationStatus", "display_name": "Configuration", "type": "text", "description": "Final configuration status"}
      ]
    },
    "Crystallographic Analysis": {
      "inputs": [
        {"name": "inputData", "display_name": "Input Data", "type": "text", "required": true, "placeholder": "Enter data or formula", "description": "Input data or material formula"},
        {"name": "modelType", "display_name": "Model Type", "type": "select", "required": true, "options": [{"value": "linear", "text": "Linear Model"}, {"value": "nonlinear", "text": "Non-linear Model"}, {"value": "ml", "text": "Machine Learning"}], "default": "linear", "description": "Type of analysis model"},
        {"name": "accuracy", "display_name": "Required Accuracy (%)", "type": "number", "required": false, "min": 50, "max": 99, "step": 1, "default": 90, "description": "Required accuracy level"},
        {"name": "realTimeUpdate", "display_name": "Real-time Updates", "type": "checkbox", "required": false, "default": true, "description": "Enable real-time updates"}
      ],
      "outputs": [
        {"name": "simulationStatus", "display_name": "Simulation Status", "type": "text", "description": "Status of simulation"},
        {"name": "modelValidation", "display_name": "Model Validation", "type": "text", "description": "Model validation results"},
        {"name": "predictions", "display_name": "Predictions", "type": "text", "description": "Structural predictions"}
      ]
    },
    "Quantum Mechanics": {
      "inputs": [
        {"name": "computationMethod", "display_name": "Computation Method", "type": "select", "required": true, "options": [{"value": "quantum", "text": "Quantum Mechanical"}, {"value": "classical", "text": "Classical Methods"}, {"value": "hybrid", "text": "Hybrid Approach"}], "default": "quantum", "description": "Computation method to use"},
        {"name": "precision", "display_name": "Precision Level", "type": "number", "required": false, "min": 1, "max": 10, "step": 1, "default": 5, "description": "Precision level for computation"},
        {"name": "boundary", "display_name": "Boundary Conditions", "type": "text", "required": false, "placeholder": "Specify conditions", "description": "Boundary conditions for calculation"},
        {"name": "parallelProcessing", "display_name": "Parallel Processing", "type": "checkbox", "required": false, "default": true, "description": "Enable parallel processing"}
      ],
      "outputs": [
        {"name": "computationStatus", "display_name": "Computation Status", "type": "text", "description": "Status of computation"},
        {"name": "discoveryPotential", "display_name": "Discovery Potential", "type": "text", "description": "Discovery potential of results"},
        {"name": "databaseExport", "display_name": "Database Export", "type": "text", "description": "Database export status"}
      ]
    },
    "Tensor Analysis": {
      "inputs": [
        {"name": "sampleId", "display_name": "Sample ID", "type": "text", "required": true, "placeholder": "Enter sample identifier", "description": "Sample identifier"},
        {"name": "characterizationType", "display_name": "Characterization Type", "type": "select", "required": true, "options": [{"value": "structural", "text": "Structural Analysis"}, {"value": "compositional", "text": "Compositional Analysis"}, {"value": "property", "text": "Property Analysis"}], "default": "structural", "description": "Type of characterization"},
        {"name": "resolution", "display_name": "Resolution (nm)", "type": "number", "required": false, "min": 0.1, "max": 1000, "step": 0.1, "default": 1, "description": "Resolution for analysis"},
        {"name": "sampleData", "display_name": "Sample Data File", "type": "file", "required": false, "accept": ".dat,.csv", "description": "Sample data file for analysis"}
      ],
      "outputs": [
        {"name": "analysisComplete", "display_name": "Analysis Status", "type": "text", "description": "Analysis completion status"},
        {"name": "correlationValue", "display_name": "Structure-Property Correlation", "type": "text", "description": "Structure-property correlation value"},
        {"name": "visualizationData", "display_name": "Visualization Data", "type": "text", "description": "Visualization data availability"}
      ]
    },
    "Device Synthesizability": {
      "inputs": [
        {"name": "deviceType", "display_name": "Device Type", "type": "select", "required": true, "options": [{"value": "transistor", "text": "Transistor"}, {"value": "diode", "text": "Diode"}, {"value": "solar_cell", "text": "Solar Cell"}, {"value": "led", "text": "LED"}, {"value": "sensor", "text": "Sensor"}], "default": "transistor", "description": "Type of device to synthesize"},
        {"name": "materialComposition", "display_name": "Material Composition", "type": "text", "required": true, "placeholder": "e.g., GaAs, SiC, InGaN", "description": "Material composition"},
        {"name": "substrateType", "display_name": "Substrate Type", "type": "select", "required": true, "options": [{"value": "silicon", "text": "Silicon"}, {"value": "sapphire", "text": "Sapphire"}, {"value": "sic", "text": "Silicon Carbide"}, {"value": "gan", "text": "Gallium Nitride"}], "default": "silicon", "description": "Substrate type"},
        {"name": "operatingTemp", "display_name": "Operating Temperature (°C)", "type": "number", "required": false, "min": -50, "max": 500, "step": 1, "default": 25, "description": "Operating temperature"},
        {"name": "fabricationMethod", "display_name": "Preferred Fabrication Method", "type": "select", "required": true, "options": [{"value": "mocvd", "text": "MOCVD"}, {"value": "mbe", "text": "MBE"}, {"value": "sputtering", "text": "Sputtering"}, {"value": "cvd", "text": "CVD"}], "default": "mocvd", "description": "Fabrication method"}
      ],
      "outputs": [
        {"name": "feasibility", "display_name": "Synthesis Feasibility", "type": "text", "description": "Feasibility score and level"},
        {"name": "recommendedProcess", "display_name": "Recommended Process", "type": "text", "description": "Recommended synthesis process"},
        {"name": "estimatedCost", "display_name": "Estimated Cost", "type": "text", "description": "Cost estimation"},
        {"name": "processTemp", "display_name": "Processing Temperature", "type": "text", "description": "Recommended processing temperature"},
        {"name": "yieldPrediction", "display_name": "Yield Prediction", "type": "text", "description": "Predicted manufacturing yield"}
      ]
    },
    "Interface Calculation": {
      "inputs": [
        {"name": "material1", "display_name": "Material 1", "type": "text", "required": true, "placeholder": "e.g., Si, GaAs, AlN", "description": "First material in interface"},
        {"name": "material2", "display_name": "Material 2", "type": "text", "required": true, "placeholder": "e.g., SiO2, Al2O3, HfO2", "description": "Second material in interface"},
        {"name": "interfaceType", "display_name": "Interface Type", "type": "select", "required": true, "options": [{"value": "coherent", "text": "Coherent Interface"}, {"value": "semicoherent", "text": "Semi-coherent Interface"}, {"value": "incoherent", "text": "Incoherent Interface"}, {"value": "grain_boundary", "text": "Grain Boundary"}], "default": "coherent", "description": "Type of interface"},
        {"name": "calculationMethod", "display_name": "Calculation Method", "type": "select", "required": true, "options": [{"value": "dft", "text": "DFT (First Principles)"}, {"value": "classical_md", "text": "Classical Molecular Dynamics"}, {"value": "tight_binding", "text": "Tight Binding"}, {"value": "empirical", "text": "Empirical Models"}], "default": "dft", "description": "Calculation method"},
        {"name": "supercellSize", "display_name": "Supercell Size (atoms)", "type": "number", "required": false, "min": 50, "max": 1000, "step": 10, "default": 200, "description": "Supercell size"},
        {"name": "includeStrain", "display_name": "Include Strain Effects", "type": "checkbox", "required": false, "default": true, "description": "Include strain effects"},
        {"name": "calculateBandOffset", "display_name": "Calculate Band Offset", "type": "checkbox", "required": false, "default": true, "description": "Calculate band offset"}
      ],
      "outputs": [
        {"name": "interfaceEnergy", "display_name": "Interface Energy", "type": "text", "description": "Interface energy"},
        {"name": "bandOffset", "display_name": "Band Offset", "type": "text", "description": "Band offset value"},
        {"name": "latticeMismatch", "display_name": "Lattice Mismatch", "type": "text", "description": "Lattice mismatch percentage"},
        {"name": "interfaceStates", "display_name": "Interface States", "type": "text", "description": "Density of interface states"},
        {"name": "chargeTransfer", "display_name": "Charge Transfer", "type": "text", "description": "Charge transfer at interface"}
      ]
    },
    "Property Prediction": {
      "inputs": [
        {"name": "materialSystem", "display_name": "Material System", "type": "text", "required": true, "placeholder": "e.g., III-V, II-VI", "description": "Material system for prediction"},
        {"name": "propertyPrediction", "display_name": "Property to Predict", "type": "select", "required": true, "options": [{"value": "bandgap", "text": "Band Gap"}, {"value": "mobility", "text": "Carrier Mobility"}, {"value": "conductivity", "text": "Electrical Conductivity"}], "default": "bandgap", "description": "Property to predict"},
        {"name": "temperature", "display_name": "Temperature (K)", "type": "number", "required": false, "min": 0, "max": 1000, "step": 1, "default": 300, "description": "Temperature for prediction"},
        {"name": "includeDefects", "display_name": "Include Defects", "type": "checkbox", "required": false, "default": false, "description": "Include defect effects"}
      ],
      "outputs": [
        {"name": "predictionStatus", "display_name": "Prediction Status", "type": "text", "description": "Status of prediction"},
        {"name": "bandGap", "display_name": "Band Gap", "type": "text", "description": "Predicted band gap"},
        {"name": "carrierMobility", "display_name": "Carrier Mobility", "type": "text", "description": "Predicted carrier mobility"}
      ]
    },
    "Band Structure": {
      "inputs": [
        {"name": "bandCalculationType", "display_name": "Band Calculation Type", "type": "select", "required": true, "options": [{"value": "dft", "text": "DFT Calculation"}, {"value": "gw", "text": "GW Approximation"}, {"value": "hybrid", "text": "Hybrid Functional"}], "default": "dft", "description": "Type of band calculation"},
        {"name": "kPoints", "display_name": "K-Points Density", "type": "number", "required": false, "min": 1, "max": 20, "step": 1, "default": 10, "description": "K-points density"},
        {"name": "latticeParams", "display_name": "Lattice Parameters", "type": "text", "required": false, "placeholder": "a, b, c values", "description": "Lattice parameters"},
        {"name": "spinOrbit", "display_name": "Include Spin-Orbit Coupling", "type": "checkbox", "required": false, "default": false, "description": "Include spin-orbit coupling"}
      ],
      "outputs": [
        {"name": "bandStructureStatus", "display_name": "Band Structure", "type": "text", "description": "Band structure calculation status"},
        {"name": "transportProperties", "display_name": "Transport Properties", "type": "text", "description": "Calculated transport properties"},
        {"name": "dosAnalysis", "display_name": "DOS Analysis", "type": "text", "description": "Density of states analysis"}
      ]
    },
    "Thermal Management": {
      "inputs": [
        {"name": "thermalProperty", "display_name": "Thermal Property", "type": "select", "required": true, "options": [{"value": "conductivity", "text": "Thermal Conductivity"}, {"value": "expansion", "text": "Thermal Expansion"}, {"value": "capacity", "text": "Heat Capacity"}], "default": "conductivity", "description": "Thermal property to analyze"},
        {"name": "operatingPower", "display_name": "Operating Power (W)", "type": "number", "required": true, "min": 0.1, "max": 1000, "step": 0.1, "default": 100, "description": "Operating power"},
        {"name": "ambientTemp", "display_name": "Ambient Temperature (°C)", "type": "number", "required": false, "min": -50, "max": 200, "step": 1, "default": 25, "description": "Ambient temperature"},
        {"name": "includeConvection", "display_name": "Include Convection", "type": "checkbox", "required": false, "default": true, "description": "Include convection effects"}
      ],
      "outputs": [
        {"name": "optimizationStatus", "display_name": "Optimization Status", "type": "text", "description": "Thermal optimization status"},
        {"name": "maxTemperature", "display_name": "Maximum Temperature", "type": "text", "description": "Maximum temperature reached"},
        {"name": "coolingSolution", "display_name": "Cooling Solution", "type": "text", "description": "Recommended cooling solution"}
      ]
    },
    "Reliability Assessment": {
      "inputs": [
